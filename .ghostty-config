palette = 8=#4B4B4B
palette = 9=#FE5F86
palette = 10=#00D787
palette = 11=#EBFF71
palette = 12=#8F69FF
palette = 13=#FF7AEA
palette = 14=#00FEFE
palette = 15=#FFFFFF
keybind = super+f=toggle_fullscreen
