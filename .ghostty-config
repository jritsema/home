theme = Ayu Mirage
font-family = Hack Nerd Font
font-size = 17
macos-titlebar-proxy-icon = hidden
working-directory = /Users/john/code
cursor-style-blink = false
cursor-color = #ffffff
adjust-cursor-thickness = 75%
mouse-hide-while-typing = true
copy-on-select = clipboard
link-url = true
window-save-state = always
keybind = cmd+d=new_split:down
keybind = cmd+shift+d=new_split:right
keybind = opt+h=goto_split:left
keybind = opt+j=goto_split:bottom
keybind = opt+k=goto_split:top
keybind = opt+l=goto_split:right
keybind = cmd+r=prompt_surface_title
confirm-close-surface = false
window-padding-x = 20
palette = 0=#282a2e
palette = 1=#D74E6F
palette = 2=#31BB71
palette = 3=#D3E561
palette = 4=#8056FF
palette = 5=#ED61D7
